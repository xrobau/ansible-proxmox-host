auto lo
iface lo inet loopback

iface eth0 inet manual
iface eth1 inet manual

auto bond0
iface bond0 inet manual
	bond-slaves eth0 eth1
	bond-mode 802.3ad
	bond-xmit-hash-policy layer2+3
	mtu 9000

auto vmbr0
iface vmbr0 inet static
	bridge-ports bond0
	bridge-stp off
	bridge-fd 0
	bridge-vlan-aware yes
	bridge-vids 2-4094
	mtu 9000

auto vmbr128
iface vmbr128 inet static
	bridge-ports vmbr0.128
	bridge-stp off
	bridge-fd 0
	address 10.8.128.51/24
	mtu 9000

auto vmbr555
iface vmbr555 inet static
	bridge-ports vmbr0.555
	bridge-stp off
	bridge-fd 0
	address 10.8.61.51/24
	gateway 10.8.61.1
	mtu 9000


source /etc/network/interfaces.d/*
